[Unit]
Description=Sync PMS password hashes into Base360 Time Tracker as soon as PMS reports a change
After=docker.service
Requires=docker.service

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/gauzy
ExecStart=/bin/bash -c 'docker run --rm --name pms-password-listener --env-file pms-sync.env pms-password-listener | while read -r line; do echo "$line"; [ "$line" = changed ] && { sleep 2; ./pms-password-sync.sh || true; }; done'
ExecStop=/usr/bin/docker stop pms-password-listener
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
