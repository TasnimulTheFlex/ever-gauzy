<mjml>
	<mj-body background-color="#fff">
		<mj-section>
			<mj-column>
				<mj-image
					width="100px"
					src="{{appLogo}}"
				></mj-image>
				<mj-divider
					border-color="#064749"
					border-width="1px"
				></mj-divider>
				<mj-text font-size="20px" font-family="helvetica"
					>Изпращане на график</mj-text
				>
				<mj-text font-size="16px" font-family="helvetica">
					<p>Dear {{email}},</p>
					<p>
						потребител {{candidateName}} на {{project}}, представете
						график за време на проекта..!!
					</p>
				</mj-text>
				<mj-text font-size="16px" font-family="helvetica">
					<p>С Най-Добри Пожелания,</p>
					<p>Base360 Team</p>
				</mj-text>
				<mj-divider
					border-color="#064749"
					border-width="1px"
				></mj-divider>
				<mj-text align="center" font-size="12px" font-family="helvetica"
					>© 2019,
					<a href="{{appLink}}" style="color: #064749"
						>{{appName}}</a
					>
					by
					<a href="{{companyLink}}" style="color: #064749"
						>{{companyName}}</a
					>
					All rights reserved.
				</mj-text>
			</mj-column>
		</mj-section>
	</mj-body>
</mjml>
